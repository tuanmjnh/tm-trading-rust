# ==============================================================================
# TM TRADING RUST — CANONICAL ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' at the repository root or runtime directory:
#   cp .env.example .env (Linux/macOS)
#   Copy-Item .env.example .env (PowerShell)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API & APPLICATION RUNTIME
# ------------------------------------------------------------------------------
# Loopback management API endpoint:
TM_TRADING_API_URL=http://127.0.0.1:8787
TM_MANAGEMENT_API_BIND=127.0.0.1:8787

# Authentication bearer token for local user / desktop operations:
TM_TRADING_LOCAL_API_TOKEN=local-dev-operator-token

# Agent bearer token for supervised worker lifecycle:
TM_TRADING_AGENT_TOKEN=local-dev-agent-token
TM_TRADING_AGENT_API_TOKEN=local-dev-agent-token

# Logging format ('compact' or 'json') and verbosity:
TM_LOG_FORMAT=compact
TM_TRADING_LOG_FORMAT=compact
RUST_LOG=info,tm_trading_desktop=info

# Desktop user interface language ('en' for English, 'vi' for Tiếng Việt):
TM_TRADING_LOCALE=vi

# ------------------------------------------------------------------------------
# 2. DATABASE & PERSISTENCE
# ------------------------------------------------------------------------------
# Primary MongoDB connection URI (TLS required in production; plaintext in dev):
TM_DATABASE_URI=mongodb://127.0.0.1:27017
TM_DATABASE_NAME=tm-trading-rust

# Set to 1/true to permit non-TLS MongoDB connections and standalone replica sets during dev:
TM_STORAGE_ALLOW_INSECURE_DEV=1

# Storage engine backend ('mongodb'):
TM_TRADING_STORE=mongodb

# Redb fallback data directory:
TM_TRADING_DATA_DIR=data

# ------------------------------------------------------------------------------
# 3. WORKER FLEET ENABLEMENT FLAGS
# ------------------------------------------------------------------------------
# Enable or disable workers (1 = enabled, 0 = disabled):
# Note: sample-worker is always registered by default.
TM_TRADING_MARKET_WORKER_ENABLED=1
TM_TRADING_RESEARCH_WORKER_ENABLED=1
TM_TRADING_NEWS_WORKER_ENABLED=1
TM_TRADING_AI_WORKER_ENABLED=1
TM_TRADING_NOTIFICATION_WORKER_ENABLED=1

# ------------------------------------------------------------------------------
# 4. MARKET WORKER CONFIGURATION
# ------------------------------------------------------------------------------
# Source-of-truth authorization flag (must be 1 for market worker to write candles):
TM_TRADING_MARKET_SOURCE_OF_TRUTH=1

# Comma-separated watchlist symbols:
TM_TRADING_MARKET_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# Primary candle timeframe (e.g. '1m', '5m', '15m', '1h', '4h', '1d'):
TM_TRADING_MARKET_TIMEFRAME=1m

# Number of historical bars to fetch per cycle:
TM_TRADING_MARKET_BARS=100

# Polling cycle interval in milliseconds:
TM_TRADING_MARKET_CYCLE_MS=5000

# Cycle timeout in milliseconds:
TM_TRADING_MARKET_CYCLE_TIMEOUT_MS=15000

# Heartbeat interval in milliseconds:
TM_TRADING_MARKET_HEARTBEAT_MS=5000

# Optional provider definition ID override (defaults to binance):
# TM_TRADING_MARKET_PROVIDER_ID=binance

# ------------------------------------------------------------------------------
# 5. RESEARCH WORKER CONFIGURATION
# ------------------------------------------------------------------------------
# Source-of-truth authorization flag (must be 1 for research worker to write events):
TM_TRADING_RESEARCH_SOURCE_OF_TRUTH=1

# Comma-separated symbols monitored for technical research:
TM_TRADING_RESEARCH_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# Analytical methodology engines enabled:
TM_TRADING_RESEARCH_METHODS=vsa,price-action,trend,wonderwhales,sweep

# Multi-tenant owner scope:
TM_TRADING_RESEARCH_OWNER_SCOPE=default

# Research analysis timeframe and bar window:
TM_TRADING_RESEARCH_TIMEFRAME=1m
TM_TRADING_RESEARCH_BARS=120

# Polling cycle and heartbeat intervals in milliseconds:
TM_TRADING_RESEARCH_CYCLE_MS=15000
TM_TRADING_RESEARCH_CYCLE_TIMEOUT_MS=20000
TM_TRADING_RESEARCH_HEARTBEAT_MS=5000

# ------------------------------------------------------------------------------
# 6. NEWS WORKER CONFIGURATION
# ------------------------------------------------------------------------------
# Source-of-truth authorization flag (must be 1 for news worker to ingest articles):
TM_TRADING_NEWS_SOURCE_OF_TRUTH=1

# Collection limits per cycle:
TM_TRADING_NEWS_MAX_SOURCES_PER_CYCLE=10
TM_TRADING_NEWS_MAX_ITEMS_PER_SOURCE=20

# News polling cycle and heartbeat intervals in milliseconds:
TM_TRADING_NEWS_CYCLE_MS=60000
TM_TRADING_NEWS_CYCLE_TIMEOUT_MS=30000
TM_TRADING_NEWS_HEARTBEAT_MS=5000

# ------------------------------------------------------------------------------
# 7. AI WORKER CONFIGURATION & PROVIDER KEYS
# ------------------------------------------------------------------------------
# Job claim and lease durations in milliseconds:
TM_TRADING_AI_CLAIM_MS=5000
TM_TRADING_AI_HEARTBEAT_MS=5000
TM_TRADING_AI_LEASE_MS=300000

# Common AI Provider API keys (automatically forwarded to ai-worker by Agent):
# GEMINI_API_KEY=AIzaSy...
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
# ANTHROPIC_API_KEY=sk-ant-...

# Dedicated namespace keys (alternative standard):
# TM_TRADING_AI_GEMINI_API_KEY=AIzaSy...
# TM_TRADING_AI_OPENROUTER_API_KEY=sk-or-...

# ------------------------------------------------------------------------------
# 8. NOTIFICATION WORKER & TELEGRAM CONFIGURATION
# ------------------------------------------------------------------------------
# Outbox claim polling and heartbeat intervals in milliseconds:
TM_TRADING_NOTIFICATION_CLAIM_MS=2000
TM_TRADING_NOTIFICATION_HEARTBEAT_MS=5000
TM_TRADING_NOTIFICATION_LEASE_MS=30000

# Telegram Bot credentials (optional in dev mode, required for active channel delivery):
# TM_TRADING_TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
# TM_TRADING_TELEGRAM_CHAT_ID=-1001234567890
# TM_TRADING_TELEGRAM_BASE_URL=https://api.telegram.org

# Aliases also supported:
# TM_TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
# TM_TELEGRAM_CHAT_ID=-1001234567890
